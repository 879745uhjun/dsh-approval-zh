{
  "name": "dsh-approval-zh",
  "version": "0.1.1",
  "description": "Automatically translate DeepSeek Harness approval prompt text to Chinese without changing approval decisions, with a model fallback when the anonymous endpoint is slow.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "approval",
    "translation",
    "chinese",
    "i18n"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "lib",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/translate.test.js",
    "test:live": "node test/live.mjs"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
