{
  "name": "dsh-approval-zh",
  "version": "0.2.0",
  "description": "Automatically translate DeepSeek Harness approval prompts and ask_user_question cards to Chinese without changing decisions or option answer values.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "approval",
    "translation",
    "chinese",
    "i18n"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "lib",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/translate.test.js",
    "test:live": "node test/live.mjs"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "license": "MIT",
  "author": "879745uhjun",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/879745uhjun/dsh-approval-zh.git"
  },
  "homepage": "https://github.com/879745uhjun/dsh-approval-zh#readme",
  "bugs": {
    "url": "https://github.com/879745uhjun/dsh-approval-zh/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
